{
  "hooks": {
    "SessionStart":     [{ "hooks": [{ "type": "command", "command": "~/claude-light/light.sh i" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "~/claude-light/light.sh w" }] }],
    "PostToolUse":      [{ "hooks": [{ "type": "command", "command": "~/claude-light/light.sh w" }] }],
    "Notification":     [{ "matcher": "permission_prompt|elicitation_dialog", "hooks": [{ "type": "command", "command": "~/claude-light/light.sh n" }] }],
    "Stop":             [{ "hooks": [{ "type": "command", "command": "~/claude-light/light.sh r" }] }],
    "SessionEnd":       [{ "hooks": [{ "type": "command", "command": "~/claude-light/light.sh i" }] }]
  }
}
