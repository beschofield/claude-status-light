# systemd user service for the status hub, sandboxed. Install (on charon):
#   python3 hub/status_hub.py --init-token   # once: creates ~/.config/claude-status-light/token
#   mkdir -p ~/.config/systemd/user
#   cp hub/status-hub.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now status-hub
#   loginctl enable-linger $USER     # keep it running when logged out
# Edit the paths if the repo lives somewhere else.
#
# The hub is reachable from the internet (Tailscale Funnel), so it runs boxed in: it sees an
# empty home folder except its own code and token (read-only), can't write anywhere but a
# private /tmp, can't gain privileges, and is limited in memory, threads and system calls.
# A bug in it could not read your other repos, keys or files.
[Unit]
Description=Claude Code status light hub
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 -I %h/Claude/claude-status-light/hub/status_hub.py --bind 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=3

# --- sandbox ---
ProtectHome=tmpfs
BindReadOnlyPaths=%h/Claude/claude-status-light/hub %h/.config/claude-status-light
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=default.target
