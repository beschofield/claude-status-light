# systemd user service for the status hub. Install (on charon):
#   mkdir -p ~/.config/systemd/user
#   cp hub/status-hub.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now status-hub
#   loginctl enable-linger $USER     # keep it running when logged out
# Edit the ExecStart path if the repo lives somewhere else.
[Unit]
Description=Claude Code status light hub
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 %h/Claude/claude-status-light/hub/status_hub.py --bind 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
